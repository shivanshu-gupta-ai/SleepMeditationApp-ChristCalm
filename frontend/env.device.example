# Physical device StoreKit sandbox / local release-style testing.
# Prefer from repo root:
#   CHRISTCALM_RC_MODE=appstore ./scripts/sync-env-from-aws.sh
#
# Then:
#   cd frontend && npx expo run:ios --device
# Or: npm run build:ios:preview / build:ios:production

EXPO_PUBLIC_BACKEND_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID
EXPO_PUBLIC_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_REGION=us-east-1

# App Store public SDK key (appl_… NOT test_…) for real/sandbox StoreKit
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_YOUR_PUBLIC_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=christcalm_premium
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
EXPO_PUBLIC_REVENUECAT_PRODUCT_MONTHLY=cc_999_1m
EXPO_PUBLIC_REVENUECAT_PRODUCT_ANNUAL_FULL=cc_5999_1y
EXPO_PUBLIC_REVENUECAT_PRODUCT_ANNUAL_MID=cc_3999_1y
EXPO_PUBLIC_REVENUECAT_PRODUCT_ANNUAL_LOW=cc_1999_1y

# Paywall ON — required for IAP / sandbox testing
EXPO_PUBLIC_UNLOCK_ALL=0
