{
  "expo": {
    "name": "ChristCalm",
    "slug": "christcalm",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "christcalm",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.christcalm.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ChristCalm uses the microphone so you can speak a concern and convert it to text for Wisdom.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.christcalm.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4ED"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "ChristCalm uses the microphone so you can speak a concern and convert it to text for Wisdom."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
