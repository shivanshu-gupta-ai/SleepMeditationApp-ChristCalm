# Backend — NON-SECRET local flags only.
# Secrets live in AWS SSM (/christcalm-preview/*) and are loaded at runtime.
# Prefer generating this file with: ./scripts/sync-env-from-aws.sh
# Safe to delete anytime.

AWS_REGION=us-east-1
SSM_PREFIX=/christcalm-preview
DYNAMODB_TABLE_PREFIX=christcalm-preview

# Optional local-only (not secrets):
# DYNAMODB_ENDPOINT_URL=
# VOICE_BUCKET=
# RATE_LIMIT_BACKEND=memory
