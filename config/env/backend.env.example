# Backend — local dev / Lambda testing
# Production secrets: SSM Parameter Store (aws/terraform)
# Full requirements: config/API_REQUIREMENTS.md

AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=christcalm-preview
# Leave empty for pure local .env; set for Lambda-style SSM load
SSM_PREFIX=

# Auth (see config/auth/)
JWT_SECRET=dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_API_GATEWAY_URL/api/auth/google/callback
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081

# Billing
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_ID=christcalm_premium

# AI / Wisdom — Bedrock (no Claude for generation; GPT-OSS 20B or Mistral)
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
# Alternatives: mistral.mistral-small-2402-v1:0 , mistral.mistral-7b-instruct-v0:2
BEDROCK_MAX_TOKENS=900
BEDROCK_TEMPERATURE=0.6
