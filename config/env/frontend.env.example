# Expo public env only — never put secrets here
# Full requirements: config/API_REQUIREMENTS.md

EXPO_PUBLIC_BACKEND_URL=https://YOUR_API_GATEWAY_URL

# AWS Cognito (from ./scripts/sync-env-from-aws.sh)
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
