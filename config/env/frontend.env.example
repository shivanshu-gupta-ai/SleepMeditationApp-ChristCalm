# Expo public config only — never put secrets here.
# Prefer auto-generate: ./scripts/sync-env-from-aws.sh
# Safe to delete anytime and re-sync.

EXPO_PUBLIC_BACKEND_URL=https://YOUR_API_GATEWAY_URL
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_DOMAIN=christcalm-preview.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_REGION=us-east-1

# Optional public RevenueCat SDK keys (client-safe, not server secrets)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Preview: unlock all content (set 0 to re-enable paywall gates)
EXPO_PUBLIC_UNLOCK_ALL=1
