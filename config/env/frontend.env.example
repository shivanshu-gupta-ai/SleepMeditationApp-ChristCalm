EXPO_PUBLIC_COGNITO_REGION=us-east-1

# RevenueCat public SDK keys (safe in client builds)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
