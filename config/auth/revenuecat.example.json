{
  "project_name": "ChristCalm",
  "platform": "ios_only",
  "ios": {
    "bundle_id": "com.christcalm.app",
    "asc_app_id": "YOUR_ASC_APP_ID",
    "asc_app_name": "Christ Calm",
    "public_api_key_app_store": "appl_YOUR_PUBLIC_IOS_KEY",
    "public_api_key_test_store": "test_YOUR_TEST_STORE_KEY",
    "note": "Use appl_ for production/sandbox device builds. test_ only for RC Test Store / web preview."
  },
  "entitlement": {
    "id": "christcalm_premium",
    "description": "Unlocks premium meditations, prayers, and AI features"
  },
  "offering": {
    "id": "default",
    "packages": [
      {
        "lookup_key": "$rc_monthly",
        "product_store_id": "cc_999_1m"
      },
      {
        "lookup_key": "$rc_annual",
        "product_store_id": "cc_5999_1y"
      },
      {
        "lookup_key": "$rc_custom_annual_mid",
        "product_store_id": "cc_3999_1y"
      },
      {
        "lookup_key": "$rc_custom_annual_low",
        "product_store_id": "cc_1999_1y"
      }
    ]
  },
  "products": {
    "monthly": {
      "store_product_id": "cc_999_1m",
      "display_name": "Monthly",
      "billing_period": "P1M"
    },
    "annual_full": {
      "store_product_id": "cc_5999_1y",
      "display_name": "Annual — Full",
      "billing_period": "P1Y"
    },
    "annual_mid": {
      "store_product_id": "cc_3999_1y",
      "display_name": "Annual — Mid",
      "billing_period": "P1Y"
    },
    "annual_low": {
      "store_product_id": "cc_1999_1y",
      "display_name": "Annual — Low",
      "billing_period": "P1Y"
    }
  },
  "webhook": {
    "url": "https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/api/revenuecat/webhook",
    "authorization_header": "Bearer <REVENUECAT_WEBHOOK_AUTHORIZATION in SSM>",
    "note": "Secret stored in AWS SSM via Terraform — never commit the real value"
  }
}
