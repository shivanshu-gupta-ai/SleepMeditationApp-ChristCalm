aws_region  = "us-east-1"
environment = "preview"

jwt_secret = "REPLACE_WITH_RANDOM_SECRET"

dynamodb_table_prefix = "christcalm-preview"

# Auth — see config/auth/ for Google OAuth & RevenueCat templates
# Preview: true skips email verification. Production: false.
cognito_auto_confirm_users = false

google_client_id     = ""
google_client_secret = ""
google_redirect_uri  = ""  # https://<api_url>/api/auth/google/callback

cors_origins = ["exp://127.0.0.1:8081", "exp://localhost:8081"]

# AI — Bedrock is default (IAM role on Lambda). OpenAI optional fallback.
llm_provider     = "bedrock"
bedrock_model_id = "anthropic.claude-3-5-sonnet-20240620-v1:0"
openai_api_key   = ""
openai_model     = "gpt-4o"

revenuecat_webhook_authorization = "your-webhook-bearer-secret"
revenuecat_entitlement_id = "christcalm_premium"